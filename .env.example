# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used for OAuth redirects and links)
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# True North API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_PROXY_URL=http://127.0.0.1:4000
# Optional public base URL for OAuth callbacks (for example https://app.example.com/api).
OAUTH_CALLBACK_BASE_URL=
# Trusted proxy IP/CIDR or Express trust-proxy keyword; local Next proxy defaults to loopback.
TRUST_PROXY=loopback
DATABASE_URL=postgresql://localhost:5432/truenorth
JWT_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Google OAuth (optional until provider credentials are configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional until provider credentials are configured)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Password recovery email (Resend)
RESEND_API_KEY=
AUTH_FROM_EMAIL=

# IRS e-file remains disabled until provider authorization and API credentials exist.
